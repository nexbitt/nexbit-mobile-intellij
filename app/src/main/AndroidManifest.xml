<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".NexbitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexbitMobile"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- Splash: entry point with role-based routing -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.NexbitMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PerfilActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ClientesActivity"
            android:exported="false" />
        
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RegistroActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProveedorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CatalogoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CarritoActivity"
            android:exported="false" />

        <activity android:name=".ui.ProductDetailActivity" android:exported="false" />
        <activity android:name=".ui.CategoriasAdminActivity" android:exported="false" />
        <activity android:name=".ui.UsuariosAdminActivity" android:exported="false" />
        <activity android:name=".ui.ProductosAdminActivity" android:exported="false" />
        <activity android:name=".ui.PedidosAdminActivity" android:exported="false" />
        <activity android:name=".ui.EntregasActivity" android:exported="false" />
        <activity android:name=".ui.MisPedidosActivity" android:exported="false" />

        <activity android:name=".ui.RecoveryActivity" android:exported="false" />
        <activity android:name=".ui.ConfirmacionPagoActivity" android:exported="false" />
        <activity android:name=".ui.ConfirmarPedidoActivity" android:exported="false" />
        <activity android:name=".ui.ChatActivity" android:exported="false" />
        <activity android:name=".ui.RevisionPagosActivity" android:exported="false" />
        <activity android:name=".ui.CheckoutManualActivity" android:exported="false" />
        <activity android:name=".ui.TrashOrdersActivity" android:exported="false" />
        <activity android:name=".ui.ReportesActivity" android:exported="false" />
        <activity android:name=".ui.HelpActivity" android:exported="false" />
        <activity android:name=".ui.ContactoActivity" android:exported="false" />
        <activity android:name=".ui.TicketActivity" android:exported="false" />
        <activity android:name=".ui.RepartidorDetailActivity" android:exported="false" />
        <activity android:name=".ui.ClientMainActivity" android:exported="false" />
        <activity android:name=".ui.PagoTransferenciaActivity" android:exported="false" />

        <!-- Orbix UI Activities -->
        <activity android:name=".ui.MainOrbixActivity" android:exported="false" />
        <activity android:name=".ui.OrdersActivity" android:exported="false" />
        <activity android:name=".ui.OrderDetailActivity" android:exported="false" />

    </application>

</manifest>