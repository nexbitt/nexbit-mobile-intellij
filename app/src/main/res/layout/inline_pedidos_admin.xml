<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <include
        layout="@layout/include_crud_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/etSearchPedidos"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:hint="Buscar pedido por ID, cliente..."
            android:paddingHorizontal="16dp"
            android:textSize="13sp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:textColorHint="@color/text_light" />
    </LinearLayout>

    <!-- Status filter chips -->
    <LinearLayout
        android:id="@+id/layoutStatusFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/chipTodos"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Todos"
            android:textColor="@color/chip_selected_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipPendiente"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Pendiente"
            android:textColor="@color/chip_text"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipRevision"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Revisión"
            android:textColor="@color/chip_text"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipConfirmado"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Confirmado"
            android:textColor="@color/chip_text"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipEnviado"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Enviado"
            android:textColor="@color/chip_text"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipEntregado"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Entregado"
            android:textColor="@color/chip_text"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipCancelado"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Cancelado"
            android:textColor="@color/chip_text"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPedidosEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Cargando pedidos..."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPedidosInline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_ios_table_container"
        android:clipToPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPedidosEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No hay pedidos aún"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
