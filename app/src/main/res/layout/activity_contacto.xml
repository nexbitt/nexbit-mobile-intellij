<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarContacto"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Contacto"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Info card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información de Contacto"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/chip_bg"
                        android:layout_marginVertical="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📧 Email: soporte@nexbit.com"
                        android:textSize="14sp"
                        android:textColor="@color/text_main"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 Teléfono: +57 601 234 5678"
                        android:textSize="14sp"
                        android:textColor="@color/text_main"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Dirección: Bogotá, Colombia"
                        android:textSize="14sp"
                        android:textColor="@color/text_main"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕐 Horario: Lun-Vie 8:00 AM - 6:00 PM"
                        android:textSize="14sp"
                        android:textColor="@color/text_main"
                        android:paddingVertical="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Form card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Envíanos un mensaje"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/chip_bg"
                        android:layout_marginVertical="10dp" />

                    <EditText
                        android:id="@+id/etContactoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Nombre"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etContactoEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:hint="Correo electrónico"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etContactoAsunto"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:hint="Asunto"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etContactoMensaje"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="8dp"
                        android:hint="Mensaje"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnEnviarMensaje"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Enviar Mensaje"
                        android:background="@drawable/bg_btn_primary"
                        android:textColor="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
