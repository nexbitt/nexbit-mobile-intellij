<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPerfil"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Mi Perfil"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <!-- Tabs -->
    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tabDatosPersonales"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Datos"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_selected"
            android:textColor="@color/chip_selected_text" />

        <TextView
            android:id="@+id/tabPapelera"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Papelera"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip"
            android:textColor="@color/chip_text" />

        <TextView
            android:id="@+id/tabSeguridad"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Seguridad"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip"
            android:textColor="@color/chip_text" />

        <TextView
            android:id="@+id/tabConfiguracion"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Config."
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/bg_chip"
            android:textColor="@color/chip_text" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/tabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp" />
    </ScrollView>
</LinearLayout>
