<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reportar Problema"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Selecciona el tipo de problema:"
        android:textColor="#6b7280"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/optionDireccion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="#f3f4f6"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Dirección incorrecta"
        android:textColor="#111827"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionCliente"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#f3f4f6"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Cliente no responde"
        android:textColor="#111827"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionAccidente"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#f3f4f6"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Accidente / Avería"
        android:textColor="#111827"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionOtro"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#f3f4f6"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Otro"
        android:textColor="#111827"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etNotasProblema"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#f9fafb"
        android:gravity="top"
        android:hint="Notas adicionales (opcional)"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:padding="12dp"
        android:textColor="#111827"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/btnCancelarProblema"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#e5e7eb"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEnviarProblema"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#ef4444"
            android:gravity="center"
            android:text="Enviar Reporte"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
