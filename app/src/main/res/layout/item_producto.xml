<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProductoItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivProducto"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1D1D1F"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Juego Utensilios"
            app:layout_constraintStart_toEndOf="@id/ivProducto"
            app:layout_constraintEnd_toStartOf="@+id/layoutCarrito"
            app:layout_constraintTop_toTopOf="@id/ivProducto" />

        <TextView
            android:id="@+id/tvPrecio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1D1D1F"
            android:singleLine="true"
            android:text="$ 5.000"
            app:layout_constraintStart_toEndOf="@id/ivProducto"
            app:layout_constraintEnd_toStartOf="@+id/layoutCarrito"
            app:layout_constraintTop_toBottomOf="@id/tvNombreProducto" />

        <TextView
            android:id="@+id/tvCategoriaProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#636366"
            android:text="Cocina"
            app:layout_constraintStart_toEndOf="@id/ivProducto"
            app:layout_constraintEnd_toStartOf="@+id/layoutCarrito"
            app:layout_constraintTop_toBottomOf="@id/tvPrecio" />

        <LinearLayout
            android:id="@+id/layoutCarrito"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnAgregarCarrito"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Añadir al carrito"
                android:src="@drawable/ic_cart_add_premium" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
