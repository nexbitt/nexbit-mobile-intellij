<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="56dp">

            <!-- ═══ HEADER ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDetalleTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pedido #000017"
                    android:textColor="#1C1C1E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btnCancelarPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_capsule_cancel"
                    android:drawableStart="@drawable/ic_close"
                    android:drawablePadding="6dp"
                    android:text="Cancelar"
                    android:textColor="#FF3B30"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <TextView
                    android:id="@+id/btnVerComprobante"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="14dp"
                    android:gravity="center"
                    android:background="@drawable/bg_capsule_accept"
                    android:drawableStart="@drawable/ic_eye"
                    android:drawablePadding="6dp"
                    android:text="Comprobante"
                    android:textColor="#34C759"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <ImageButton
                    android:id="@+id/btnCloseDetalle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_capsule_cancel"
                    android:scaleType="center"
                    android:src="@drawable/ic_close"
                    android:tint="#FF3B30"
                    android:contentDescription="Cerrar" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E5E7EB" />

            <!-- ═══ INFO CARD ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_crud_input"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvDetalleCliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thomas Barrero"
                    android:textColor="#1C1C1E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="PENDIENTE DE PAGO"
                    android:textAllCaps="true"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="23 de junio de 2026"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetalleTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="$20,000"
                    android:textColor="#1C1C1E"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ═══ COMPROBANTE ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPROBANTE DE PAGO"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutComprobanteThumb"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_crud_input"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivComprobanteThumb"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_image"
                    android:tint="#8E8E93"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSinComprobante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin comprobante"
                    android:textColor="#8E8E93"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E5E7EB" />

            <!-- ═══ PRODUCTOS ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRODUCTOS"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutProductosDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
