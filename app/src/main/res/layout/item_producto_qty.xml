<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvProdNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#111827"
        android:textSize="13sp"
        android:text="Producto" />

    <LinearLayout
        android:id="@+id/layoutQtyControl"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/bg_qty_control"
        android:layout_marginEnd="8dp">

        <ImageView
            android:id="@+id/ivQtyMinus"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_minus"
            android:tint="#374151" />

        <TextView
            android:id="@+id/tvQtyValue"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivQtyPlus"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_plus"
            android:tint="#374151" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProdSubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="#374151"
        android:textSize="13sp"
        android:text="$0.00" />

    <FrameLayout
        android:id="@+id/btnRemoveProducto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_red"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_trash_alt"
            android:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
