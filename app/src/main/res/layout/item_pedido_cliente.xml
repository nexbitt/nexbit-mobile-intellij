<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila superior: ID + Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPedidoId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pedido #1"
                android:textColor="#0f172a"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPedidoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textColor="#f59e0b"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvPedidoFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2026-05-25 10:30"
            android:textColor="#64748b"
            android:textSize="12sp" />

        <!-- Dirección -->
        <TextView
            android:id="@+id/tvPedidoDireccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍 Sin dirección"
            android:textColor="#475569"
            android:textSize="13sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#e2e8f0" />

        <!-- Fila inferior: Total + Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPedidoTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="$0.00"
                android:textColor="#0f172a"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTicketPedido"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="16dp"
                android:text="Ticket"
                android:textColor="#4b5563"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp"
                android:visibility="visible" />

            <Button
                android:id="@+id/btnCancelarPedido"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="16dp"
                android:text="Cancelar"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="#ef4444"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnChatPedido"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="#f3f4f6"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#111827"
                android:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
