<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_cart"
        android:contentDescription="Carrito"
        android:layout_marginBottom="24dp"
        android:alpha="0.4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Debes iniciar sesión para ver tus pedidos"
        android:textSize="16sp"
        android:textColor="#1D1D1F"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicia sesión o regístrate para acceder a tus pedidos y su seguimiento."
        android:textSize="13sp"
        android:textColor="#8E8E93"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGuestLoginRedirect"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Iniciar Sesión / Registrarse"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_btn_rounded_primary"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:stateListAnimator="@null" />

</LinearLayout>
