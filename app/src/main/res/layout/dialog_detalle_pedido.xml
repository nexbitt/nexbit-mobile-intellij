<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- ── Header: Title + Close ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDetalleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pedido #000001"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E" />

        <ImageButton
            android:id="@+id/btnCerrarDetalle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#86868B"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- ── Download ticket button ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDescargarTicket"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        app:backgroundTint="#1C1C1E"
        android:text="Descargar Ticket"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        app:cornerRadius="8dp"
        android:drawableStart="@drawable/ic_download"
        android:drawableTint="#FFFFFF"
        android:drawablePadding="6dp"
        android:stateListAnimator="@null" />

    <!-- ── Info Block (two columns) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F8F9FA"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLIENTE"
                android:textSize="11sp"
                android:textColor="#86868B"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvClienteValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Juan Cliente"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="FECHA"
                android:textSize="11sp"
                android:textColor="#86868B"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvFechaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2 de julio de 2026"
                android:textSize="14sp"
                android:textColor="#1C1C1E" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO"
                android:textSize="11sp"
                android:textColor="#86868B"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ENTREGADO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_success"
                android:textColor="#2E7D32" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TOTAL"
                android:textSize="11sp"
                android:textColor="#86868B"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvTotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$19,000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Productos section ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Productos"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E" />

    <LinearLayout
        android:id="@+id/llProductosDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp" />

    <!-- ── Action buttons ── -->
    <LinearLayout
        android:id="@+id/llAccionesDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center" />

</LinearLayout>
